// ─── SERVIDOR WEB ────────────────────────────────────────────────
function iniciarServidor() {
  const server = http.createServer((req, res) => {
    res.setHeader('Access-Control-Allow-Origin', '*');
    res.setHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
    res.setHeader('Access-Control-Allow-Headers', 'Content-Type');
    if (req.method === 'OPTIONS') { res.writeHead(200); res.end(); return; }

    if (req.method === 'GET' && req.url === '/') {
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8' });
      res.end(PANEL_HTML);
      return;
    }
    if (req.method === 'GET' && req.url === '/estado') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ activo: config.activo, conectado: botConectado, stats, bot: BOT_NAME }));
      return;
    }
    if (req.method === 'POST' && req.url === '/toggle') {
      let body = '';
      req.on('data', d => body += d);
      req.on('end', () => {
        try {
          const data = JSON.parse(body);
          config.activo = data.activo;
          saveConfig();
          console.log('Bot ' + (config.activo ? '✅ ACTIVADO' : '🔴 DESACTIVADO') + ' desde panel');
          res.writeHead(200, { 'Content-Type': 'application/json' });
          res.end(JSON.stringify({ activo: config.activo }));
        } catch(e) { res.writeHead(400); res.end('{}'); }
      });
      return;
    }
    if (req.method === 'POST' && req.url === '/reiniciar') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ ok: true }));
      setTimeout(() => process.exit(0), 500);
      return;
    }
    if (req.method === 'POST' && req.url === '/nuevo-qr') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({ ok: true }));
      setTimeout(() => { fs.rmSync('auth_info', { recursive: true, force: true }); process.exit(0); }, 500);
      return;
    }
    res.writeHead(404);
    res.end('Not found');
  });

  server.listen(PORT, '0.0.0.0', () => {
    console.log('🌐 Panel web: http://localhost:' + PORT);
    console.log('📱 Abre esa URL en Chrome para controlar el bot\n');
  });
}

// ─── BOT ────────────────────────────────────────────────────────
async function startBot() {
  if (reconectando) return;
  reconectando = true;

  try {
    const { state, saveCreds } = await useMultiFileAuthState('auth_info');
    const sock = makeWASocket({
      auth: state,
      logger: pino({ level: 'silent' }),
      printQRInTerminal: false,
      keepAliveIntervalMs: 10000,
      connectTimeoutMs: 60000,
      retryRequestDelayMs: 2000,
    });

    reconectando = false;
    intentos = 0;

    sock.ev.on('connection.update', (update) => {
      const { connection, lastDisconnect, qr } = update;
      if (qr) { console.log('\n📱 Escanea este QR:\n'); qrcode.generate(qr, { small: true }); }
      if (connection === 'close') {
        botConectado = false;
        const code = lastDisconnect?.error?.output?.statusCode;
        if (code === DisconnectReason.loggedOut) { console.log('❌ Sesión cerrada. Usa panel → Nuevo QR.'); return; }
        intentos++;
        if (intentos > MAX_INTENTOS) { fs.rmSync('auth_info', { recursive: true, force: true }); intentos = 0; }
        const espera = Math.min(intentos * 3000, 15000);
        console.log('🔄 Reconectando en ' + espera/1000 + 's...');
        setTimeout(() => { reconectando = false; startBot(); }, espera);
      }
      if (connection === 'open') {
        botConectado = true;
        console.log('\n✅ ' + BOT_NAME + ' conectado!');
        console.log('Estado: ' + (config.activo ? '🟢 Activo' : '🔴 Inactivo') + '\n');
        intentos = 0;
      }
    });

    sock.ev.on('creds.update', saveCreds);
    setInterval(async () => { try { await sock.sendPresenceUpdate('available'); } catch {} }, 30000);

    sock.ev.on('group-participants.update', async ({ id, participants, action }) => {
      try {
        if (action === 'remove' || action === 'leave') {
          stats.salidas++;
          const frase = frasesRetiro[Math.floor(Math.random() * frasesRetiro.length)];
          const num = participants[0].replace('@s.whatsapp.net', '');
          await sock.sendMessage(id, { text: '👋 *' + num + '* acaba de salir.\n\n😂 ' + frase });
        }
        if (action === 'add') {
          stats.entradas++;
          for (const participant of participants) {
            const num = participant.replace('@s.whatsapp.net', '');
            let ppUrl = null;
            try { ppUrl = await sock.profilePictureUrl(participant, 'image'); } catch {}
            const welcomeText = '🎉 *¡Bienvenido/a!* 🎉\n\n👤 *Número:* ' + num + '\n🌟 Escribe *!help* para ver los comandos.\n' + FIRMA;
            if (ppUrl) {
              await sock.sendMessage(id, { image: { url: ppUrl }, caption: welcomeText, mentions: [participant] });
            } else {
              await sock.sendMessage(id, { text: welcomeText, mentions: [participant] });
            }
          }
        }
      } catch(e) { console.log('Error group:', e.message); }
    });

    sock.ev.on('messages.upsert', async ({ messages }) => {
      try {
        const msg = messages[0];
        if (!msg.message) return;
        if (msg.key.fromMe) return;
        stats.mensajes++;

        const from = msg.key.remoteJid;
        const senderNumber = from.replace('@s.whatsapp.net', '').replace('@g.us', '');
        const esOwner = msg.key.participant
          ? msg.key.participant.replace('@s.whatsapp.net', '') === OWNER_NUMBER
          : senderNumber === OWNER_NUMBER;

        const texto = msg.message?.conversation || msg.message?.extendedTextMessage?.text || '';
        const body = texto.trim();
        const comando = body.split(' ')[0].toLowerCase();
        const args = body.split(' ').slice(1);
        const bodyLower = body.toLowerCase();
        const responder = (text) => sock.sendMessage(from, { text }, { quoted: msg });

        if (esOwner) {
          if (comando === '!activar') { config.activo = true; saveConfig(); responder('✅ *' + BOT_NAME + ' activado!*\n' + FIRMA); return; }
          if (comando === '!desactivar') { config.activo = false; saveConfig(); responder('🔴 *' + BOT_NAME + ' desactivado!*\n' + FIRMA); return; }
          if (comando === '!broadcast') { if (!args.length) return responder('Uso: !broadcast <mensaje>'); responder('📢 ' + args.join(' ') + '\n' + FIRMA); return; }
          if (comando === '!status') { responder('📊 *' + BOT_NAME + '*\n\n' + (config.activo ? '🟢 Activo' : '🔴 Inactivo') + '\n📨 Mensajes: ' + stats.mensajes + '\n⚡ Comandos: ' + stats.comandos + '\n' + FIRMA); return; }
          if (comando === '!say') { if (!args.length) return responder('Uso: !say <mensaje>'); sock.sendMessage(from, { text: args.join(' ') }); return; }
          if (comando === '!ownerhelp') { responder('👑 *Owner:*\n\n🟢 !activar\n🔴 !desactivar\n📢 !broadcast\n📊 !status\n🗣️ !say\n' + FIRMA); return; }
        }

        if (!config.activo) return;
        if (comando.startsWith('!')) stats.comandos++;

        if (comando === '!help') { responder('📋 *Comandos:*\n\n🔹 !help\n🔹 !ping\n🔹 !info\n🔹 !hora\n🔹 !dado\n🔹 !chiste\n🔹 !creador\n🔹 !moneda\n🔹 !frase\n🔹 !enamorado\n🔹 !gay\n🔹 !estupido\n🔹 !suerte\n🔹 !calcula\n\n' + FIRMA); return; }
        if (comando === '!ping') { responder('🏓 Pong! Activo.\n' + FIRMA); return; }
        if (comando === '!info') { responder('ℹ️ *' + BOT_NAME + '*\n👑 Albert Oficial\n⚙️ Baileys v2.0\n🌎 Perú 🇵🇪\n' + FIRMA); return; }
        if (comando === '!hora') { responder('🕐 ' + new Date().toLocaleString('es-PE', { timeZone: 'America/Lima' }) + '\n' + FIRMA); return; }
        if (comando === '!dado') { const r = Math.floor(Math.random()*6)+1; responder('🎲 ' + ['','1️⃣','2️⃣','3️⃣','4️⃣','5️⃣','6️⃣'][r] + ' (' + r + ')\n' + FIRMA); return; }
        if (comando === '!chiste') { responder('😂 ' + chistes[Math.floor(Math.random()*chistes.length)] + '\n' + FIRMA); return; }
        if (comando === '!creador') { responder('👑 *Albert Oficial*\nDesarrollador peruano de bots WhatsApp.\n🇵🇪\n' + FIRMA); return; }
        if (comando === '!moneda') { responder('🪙 ' + (Math.random()<.5?'CARA':'SELLO') + '\n' + FIRMA); return; }
        if (comando === '!frase') { const f=['El exito es la suma de pequeños esfuerzos.','No te detengas, sigue adelante.','Cree en ti mismo.','Cada dia es una nueva oportunidad.','Tu unico limite eres tu mismo.']; responder('💪 ' + f[Math.floor(Math.random()*f.length)] + '\n' + FIRMA); return; }
        if (comando === '!enamorado') { const n=Math.floor(Math.random()*101); const b='❤️'.repeat(Math.floor(n/10))+'🖤'.repeat(10-Math.floor(n/10)); const c=n<20?'Eres de piedra. 🗿':n<40?'Algo de sentimientos. 🤏':n<60?'Ni frío ni caliente. 😐':n<80?'Bien enamoradito. 🥰':'¡Perdidamente enamorado! 💘'; responder('💕 *Nivel Enamorado*\n\n'+b+'\n📊 '+n+'%\n\n'+c+'\n'+FIRMA); return; }
        if (comando === '!gay') { const n=Math.floor(Math.random()*101); const b='🌈'.repeat(Math.floor(n/10))+'⬜'.repeat(10-Math.floor(n/10)); const c=n<20?'Bien machito. 💪':n<40?'Solo curioso. 👀':n<60?'En el medio. 😏':n<80?'Ya casi. 🌈':'Full arcoiris! 🏳️‍🌈'; responder('🌈 *Nivel Gay*\n\n'+b+'\n📊 '+n+'%\n\n'+c+'\n'+FIRMA); return; }
        if (comando === '!estupido') { const n=Math.floor(Math.random()*101); const b='🧠'.repeat(Math.floor(n/10))+'💀'.repeat(10-Math.floor(n/10)); const c=n<20?'Bastante inteligente. 😏':n<40?'Solo un poco. 😅':n<60?'Nivel intermedio. 🤦':n<80?'Ya preocupa. 😬':'Nivel crítico! 💀'; responder('🧠 *Nivel Estupidez*\n\n'+b+'\n📊 '+n+'%\n\n'+c+'\n'+FIRMA); return; }
        if (comando === '!suerte') { const n=Math.floor(Math.random()*101); const b='🍀'.repeat(Math.floor(n/10))+'💀'.repeat(10-Math.floor(n/10)); const c=n<20?'Quédate en casa. 🏠':n<40?'No es tu día. 😬':n<60?'Día normal. 😐':n<80?'Bastante suerte! 🍀':'¡Juega la lotería! 🎰'; responder('🍀 *Tu suerte*\n\n'+b+'\n📊 '+n+'%\n\n'+c+'\n'+FIRMA); return; }
        if (comando === '!calcula') {
          if (args.length < 3) return responder('Uso: !calcula 10 + 5');
          const a=parseFloat(args[0]),op=args[1],b=parseFloat(args[2]);
          if (isNaN(a)||isNaN(b)) return responder('Números inválidos.');
          let r; if(op==='+')r=a+b; else if(op==='-')r=a-b; else if(op==='*')r=a*b; else if(op==='/')r=b!==0?a/b:'No dividas entre 0'; else return responder('Operación inválida.');
          responder('🧮 '+a+' '+op+' '+b+' = *'+r+'*\n'+FIRMA); return;
        }
        if (bodyLower.includes('hola')||bodyLower.includes('buenas')||bodyLower.includes('alo')) { responder('👋 Hola! Soy *'+BOT_NAME+'*. Escribe *!help*.\n'+FIRMA); return; }
        if (bodyLower.includes('buenos dias')) { responder('🌅 Buenos días!\n'+FIRMA); return; }
        if (bodyLower.includes('buenas tardes')) { responder('🌇 Buenas tardes!\n'+FIRMA); return; }
        if (bodyLower.includes('buenas noches')) { responder('🌙 Buenas noches!\n'+FIRMA); return; }
        if (bodyLower.includes('gracias')) { responder('🙏 De nada! — Albert Oficial\n'+FIRMA); return; }
        if (bodyLower.includes('quien eres')||bodyLower.includes('que eres')) { responder('🤖 Soy *'+BOT_NAME+'* por *Albert Oficial*.\n'+FIRMA); return; }
        if (bodyLower.includes('como estas')||bodyLower.includes('como estás')) { responder('🤖 Al 100%!\n'+FIRMA); return; }
        if (bodyLower.includes('te quiero')||bodyLower.includes('te amo')) { responder('❤️ Yo también! Soy un bot jaja.\n'+FIRMA); return; }
        if (bodyLower.includes('aburrido')||bodyLower.includes('aburrida')) { responder('😂 Escribe *!chiste* o *!dado*!\n'+FIRMA); return; }

      } catch(e) { console.log('Error mensaje:', e.message); }
    });

  } catch(e) {
    console.log('Error iniciando:', e.message);
    reconectando = false;
    setTimeout(() => startBot(), 5000);
  }
}

iniciarServidor();
startBot();
